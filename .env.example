# Saturn streetwear customizer — copy to .env and fill in locally.
# Hugging Face Spaces: set these as Space secrets / variables (never commit .env).

# --- Geometry / compositing ---
# Edge length of each cube face, in pixels.
SATURN_PANEL_SIZE=512
# Face mapping: single | wrap | grid | auto
SATURN_FACE_MODE=single
# Thin gap between Latin-cross net panels, in pixels (reads as a white grid on a light tee).
SATURN_NET_GAP=3
# Optional overrides; defaults live under assets/
# SATURN_TEE_FRONT=assets/tee_front.png
# SATURN_TEE_BACK=assets/tee_back.png

# --- Feature flags (v1: keep these off) ---
# Multi-view diffusion / SF3D hook. v1 always uses PIL geometry.
SATURN_ENABLE_MULTIVIEW=false
# Printify live create. The Gradio UI does not call Printify in v1.
SATURN_ENABLE_PRINTIFY=false

# --- Printify (stub client only; required only if you call printify.PrintifyClient.create_product) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# PRINTIFY_API_BASE=https://api.printify.com
