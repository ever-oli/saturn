# Saturn streetwear customizer — copy to .env and fill in locally.
# Hugging Face Spaces: set these as Space secrets / variables (never commit .env).

# --- FLUX.2-klein-9B (primary; FLUX Non-Commercial — not for paid merch) ---
SATURN_ENABLE_FLUX=true
# SATURN_SKIP_MODEL_LOAD=false
# SATURN_FLUX_MODEL=black-forest-labs/FLUX.2-klein-9B
# If 9B OOMs on ZeroGPU large (~48GB; 9B wants ~29GB), try:
# SATURN_FLUX_MODEL=black-forest-labs/FLUX.2-klein-9b-fp8
SATURN_FLUX_STEPS=4
SATURN_FLUX_GUIDANCE=1.0
SATURN_FLUX_MAX_SEQ=512
SATURN_FLUX_DURATION=85
# Gated (auto): Space secret HF_TOKEN + Accept the 9B license on the Hub.
# HF_TOKEN=
# SATURN_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# --- Geometry / experimental PIL ---
SATURN_PANEL_SIZE=512
# Face mapping: auto | single | wrap | emblem | grid
SATURN_FACE_MODE=auto
SATURN_NET_GAP=3
# SATURN_TEE_FRONT=assets/tee_front.png
# SATURN_TEE_BACK=assets/tee_back.png

# --- Legacy Zero123++ (not loaded by the UI; CC-BY-NC weights) ---
SATURN_ENABLE_MULTIVIEW=false
# SATURN_ZERO123_MODEL=sudo-ai/zero123plus-v1.2
# SATURN_ZERO123_PIPELINE=sudo-ai/zero123plus-pipeline
# SATURN_ZERO123_STEPS=36
# SATURN_ZERO123_GUIDANCE=4.0
# SATURN_ZERO123_DURATION=90

# --- Printify (stub only; generate does not call it; 9B is non-commercial) ---
SATURN_ENABLE_PRINTIFY=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# PRINTIFY_API_BASE=https://api.printify.com
